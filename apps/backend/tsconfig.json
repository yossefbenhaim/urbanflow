{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": [
      "ES2020"
    ],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitAny": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}