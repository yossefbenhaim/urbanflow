{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@silver-castle/backend": ["../backend/src/router"]
    }
  },
  "include": ["src", "../backend/src/router.ts", "../backend/src/routers/*.ts", "../backend/src/middleware/auth.ts", "../backend/src/context.ts"],
  "exclude": ["src/test", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
